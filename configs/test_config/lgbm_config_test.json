{
    "model_type": "LGBMClassifier",
    "use_oversampling": true,
    "oversampler_type": "SMOTE",
    "oversampler_seed": 42,
    "train_test_split_seed": 20,
    "cv_seed": 7,
    "cv_splits": 5,
    "scoring_metric": "roc_auc",
    "search_method": "gridcv",
    "nested_cv":true,
    "hpo_n_trials": 5,
    "fixed_params": {
        "random_state": 42,
        "verbose": -1,
        "objective": "binary"
    },
    "grid_search_params": {
        "n_estimators": [100, 200],
        "max_depth": [3, 6]
    },
    "halving_search_params": {
        "n_estimators": [100, 200],
        "max_depth": [3, 6],
        "learning_rate": [0.01, 0.05],
        "num_leaves": [31, 50]
    },
    "optuna_search_params": {
        "n_estimators": "optuna.distributions.IntDistribution(100, 400)",
        "max_depth": "optuna.distributions.IntDistribution(3, 15)",
        "learning_rate": "optuna.distributions.FloatDistribution(0.01, 0.2)",
        "num_leaves": "optuna.distributions.IntDistribution(31, 150)"
    }
}
