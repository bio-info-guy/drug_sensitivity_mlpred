{
    "model_type": "XGBClassifier",
    "use_oversampling": true,
    "oversampler_type": "SMOTE",
    "oversampler_seed": 42,
    "train_test_split_seed": 20,
    "cv_seed": 7,
    "cv_splits": 5,
    "scoring_metric": "precision",
    "search_method": "gridcv",
    "fixed_params": {
        "random_state": 42,
        "eval_metric": "logloss"
    },
    "grid_search_params": {
        "n_estimators": [100, 150, 200],
        "max_depth": [3, 6, 10],
        "learning_rate": [0.01, 0.1, 0.2]
    }
}
