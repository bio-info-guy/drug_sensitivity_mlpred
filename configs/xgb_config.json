{
    "model_type": "XGBClassifier",
    "use_oversampling": true,
    "oversampler_type": "SMOTE",
    "oversampler_seed": 42,
    "train_test_split_seed": 20,
    "cv_seed": 7,
    "cv_splits": 5,
    "scoring_metric": "average_precision",
    "search_method": "optuna",
    "nested_cv": true,
    "hpo_n_trials": 30,
    "scale_data": false,
    "fixed_params": {
    },
    "grid_search_params": {
 	    "learning_rate" : [0.01, 0.05, 0.1, 0.2],
 	    "max_depth" : [5, 8, 12, 15, 20],
 	    "min_child_weight" : [ 1, 3, 5, 7 ],
	    "subsample": [0.5,  0.75,  1.0]
    },
    "halving_search_params":{
        "learning_rate" : [0.01, 0.05, 0.1, 0.2],
 	    "max_depth" : [5, 8, 12, 15, 20],
 	    "min_child_weight" : [ 1, 3, 5, 7 ],
	    "subsample": [0.6,  0.7,  0.8, 1.0]
    },
    "optuna_search_params":{
        "learning_rate" : "optuna.distributions.FloatDistribution(0, 1)",
 	    "max_depth" : "optuna.distributions.IntDistribution(3, 200)",
 	    "min_child_weight" : "optuna.distributions.IntDistribution(1, 10)",
	    "subsample": "optuna.distributions.FloatDistribution(0.5, 1.0)",
        "n_estimators": "optuna.distributions.IntDistribution(50, 500)"
    }
}
