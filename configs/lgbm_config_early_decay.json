{
    "model_type": "lgbm",
    "y_transform_option": "quantile",
    "y_transform_quantile": 0.25,
    "y_transform_percentage_threshold": 0.5,
    "use_oversampling": false,
    "oversampler_type": "SMOTE",
    "oversampler_seed": 42,
    "train_test_split_seed": 20,
    "train_test_split_ratio": 0.2,
    "test_cell_lines": [],
    "cv_seed": 7,
    "cv_splits": 5,
    "scoring_metric": "average_precision",
    "search_method": "optuna",
    "hpo_n_trials": 200,
    "scale_data": false,
    "early_stop": true,
    "lr_decay": true,
    "pca": true,
    "fixed_params": {
        "random_state": 42,
        "n_estimators":1000,
        "verbose": -1,
        "subsample_freq": 1,
        "is_unbalance": false
    },
    "grid_search_params": {
        "n_estimators": [100, 200, 300],
        "max_depth": [3, 6, 10, -1],
        "learning_rate": [0.01, 0.1, 0.2],
        "num_leaves": [31, 50, 100]
    },
    "halving_search_params": {
        "n_estimators": [100, 200, 300, 400],
        "max_depth": [3, 6, 10, 15, -1],
        "learning_rate": [0.01, 0.05, 0.1, 0.2],
        "num_leaves": [31, 50, 75, 100, 150]
    },
    "optuna_search_params": {
        "max_depth": "optuna.distributions.IntDistribution(3, 200)",
        "min_child_samples": "optuna.distributions.IntDistribution(3, 30)",
        "min_child_weight": "optuna.distributions.FloatDistribution(0.01, 20)",
        "num_leaves": "optuna.distributions.IntDistribution(10, 500)",
        "subsample": "optuna.distributions.FloatDistribution(0.5, 1.0)",
        "scale_pos_weight": "optuna.distributions.FloatDistribution(1, 10)"
    }
}
