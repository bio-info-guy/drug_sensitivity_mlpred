{
    "model_type": "XGBClassifier",
    "use_oversampling": false,
    "oversampler_type": "SMOTE",
    "oversampler_seed": 42,
    "train_test_split_seed": 20,
    "cv_seed": 7,
    "cv_splits": 5,
    "scoring_metric": "average_precision",
    "search_method": "optuna",
    "fixed_params": {
    },
    "grid_search_params": {
 	    "max_depth" : [ 5, 10],
 	    "min_child_weight" : [ 1, 3]
    },
    "optuna_search_params":{
        "learning_rate" : "optuna.distributions.FloatDistribution(0.01, 0.1)",
 	    "max_depth" : "optuna.distributions.IntDistribution(5, 20)",
 	    "min_child_weight" : "optuna.distributions.IntDistribution(1, 7)",
	    "subsample": "optuna.distributions.FloatDistribution(0.5, 1.0)"
    }
}
